+// Move through one tiling-tree relationship per keypress. This intentionally
+// leaves upstream move_window and focus behavior untouched.
+void Hy3Layout::moveCosmic(const CWorkspace* workspace, ShiftDirection direction) {
+ auto* focused = getWorkspaceFocusedNode(workspace);
+ if (!focused) return;
+ auto* node = &focused->getExpandActor().getPlacementActor();
+ auto* original = node->parent.get();
+ if (!original || original->is_root()) return;
+ auto* child = node;
+ auto* parent = original;
+ const bool forward = shiftIsForward(direction);
+ const auto axis = shiftIsVertical(direction) ? Hy3GroupLayout::SplitV : Hy3GroupLayout::SplitH;
+ Hy3Node* destination = nullptr;
+ std::list<UP<Hy3Node>>::iterator insertion;
+ while (parent && !parent->is_root()) {
+  auto& group = parent->as_group();
+  // Tabs and locked/expanded groups keep upstream behavior.
+  if (!group.isSplit() || group.locked) {
+   shiftOrGetFocus(*focused, direction, true, true, false);
+   return;
+  }
+  auto current = group.findChild(*child);
+  if (!shiftMatchesLayout(group.layout, direction)) {
+   if (group.children.size() == 1 && child == node && parent->is_root_group()) return;
+   parent->wrap(axis, GroupEphemeralityOption::Standard);
+   destination = parent->parent.get();
+   insertion = forward ? destination->as_group().children.end() : destination->as_group().children.begin();
+   break;
+  }
+  if (child != node) {
+   destination = parent;
+   insertion = forward ? std::next(current) : current;
+   break;
+  }
+  const bool boundary = forward ? std::next(current) == group.children.end() : current == group.children.begin();
+  if (boundary) { child = parent; parent = parent->parent.get(); continue; }
+  auto next = forward ? std::next(current) : std::prev(current);
+  auto* neighbor = next->get();
+  if (group.children.size() > 2) {
+   neighbor->wrap(axis, GroupEphemeralityOption::Standard);
+   destination = neighbor->parent.get();
+   insertion = forward ? destination->as_group().children.begin() : destination->as_group().children.end();
+  } else if (neighbor->is_group() && neighbor->as_group().isSplit() && !neighbor->as_group().locked) {
+   destination = neighbor;
+   auto& into = neighbor->as_group();
+   if (shiftMatchesLayout(into.layout, direction)) {
+    insertion = forward ? into.children.begin() : into.children.end();
+   } else {
+    auto middle = std::next(into.children.begin(), into.children.size() / 2);
+    if (into.children.size() % 2 == 0) insertion = middle;
+    else {
+     auto* center = middle->get();
+     center->wrap(axis, GroupEphemeralityOption::Standard);
+     destination = center->parent.get();
+     insertion = forward ? destination->as_group().children.begin() : destination->as_group().children.end();
+    }
+   }
+  } else {
+   destination = parent;
+   insertion = forward ? std::next(next) : next;
+  }
+  break;
+ }
+ if (!destination) return; // Reaching the workspace edge is a no-op.
+ if (destination == original) {
+  auto& children = original->as_group().children;
+  children.splice(insertion, children, original->as_group().findChild(*node));
+ } else {
+  auto moving = original->as_group().extractChild(*node);
+  destination->as_group().insertChild(insertion, std::move(moving));
+  original->collapseParents(CollapsePolicy::SingleNodeGroups);
+ }
+ node->updateTabBarRecursive();
+ node->focus(false, Desktop::FOCUS_REASON_KEYBIND);
+ recalcGeometry();
+}
