+// Directional tree movement, separate from the upstream hy3 dispatcher.
+static int luaMoveCosmic(lua_State* L) {
+ luaCheckArgCount(L, "hl.plugin.hy3.move_cosmic", 1, 1);
+ auto direction = luaShiftArg(L, 1, "hl.plugin.hy3.move_cosmic");
+ lua_pushinteger(L, static_cast<lua_Integer>(direction));
+ lua_pushcclosure(L, [](lua_State* L) -> int {
+  auto* layout = hy3InstanceForAction();
+  if (layout) layout->moveCosmic(layout->workspace().get(),
+      static_cast<ShiftDirection>(lua_tointeger(L, lua_upvalueindex(1))));
+  return 0;
+ }, 1);
+ return 1;
+}
